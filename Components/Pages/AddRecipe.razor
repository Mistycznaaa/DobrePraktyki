@page "/add-recipe"
@using HormoneHarmony.Models
@using HormoneHarmony.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject IDbContextFactory<HormoneHarmony.Data.AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS

@rendermode InteractiveServer



<div style="padding: 40px; max-width: 900px; margin: 0 auto; background-color: #FFF5F7; min-height: 100vh;">
    
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 style="font-family: serif; color: #4A154B; font-size: 2.5rem;">Add a New Recipe</h1>
        <p style="color: #888;">Share your hormone balancing creations.</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div id="errorSummary" style="background-color: #FFEBEE; color: #C62828; padding: 15px; border-radius: 10px; margin-bottom: 20px; text-align: center; border: 1px solid #EF9A9A; font-weight: bold;">
            ⚠️ @errorMessage
        </div>
    }

    <EditForm Model="@FormModel" OnValidSubmit="HandleSave" FormName="AddRecipeForm">
        <div style="background: white; border-radius: 30px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">

            <div style="border: 2px dashed #FCEEF2; border-radius: 20px; padding: 40px; text-align: center; margin-bottom: 30px; position: relative;">
                <p style="color: #D17D98; font-weight: bold;">📷 Dish Photo</p>
                @if (string.IsNullOrEmpty(FormModel.ImageUrl))
                {
                    <div style="color: #888; margin-top: 10px;">
                        <p>Click to upload a photo of your dish</p>
                        <span style="font-size: 0.8rem;">Supports: JPG, PNG</span>
                    </div>
                }
                else
                {
                    <p style="color: #4CAF50; margin-top: 10px;">✅ Photo ready: @FormModel.ImageUrl</p>
                }
                <InputFile OnChange="LoadFiles" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px;">
                
                <div>
                    <h3 style="color: #4A154B; font-family: serif; margin-bottom: 15px;">Basic Details</h3>
                    
                    <label style="display: block; margin-bottom: 5px; font-size: 0.9rem;">Recipe Title</label>
                    <InputText @bind-Value="FormModel.Title" placeholder="e.g. Glowing Green Smoothie"
                               style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #eee; margin-bottom: 15px;" />

                    <label style="display: block; margin-bottom: 5px; font-size: 0.9rem;">Description</label>
                    <InputTextArea @bind-Value="FormModel.Description" placeholder="Briefly describe your dish..."
                                   style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #eee; height: 100px;" />
                </div>

                <div>
                    <h3 style="color: #4A154B; font-family: serif; margin-bottom: 15px;">Ingredients</h3>
                    <p style="font-size: 0.8rem; color: #999; margin-bottom: 5px;">Separate with a semicolon (;)</p>
                    <InputTextArea @bind-Value="FormModel.Ingredients" placeholder="Avocado; Walnuts; Spinach..."
                                   style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #eee; height: 150px;" />
                </div>
            </div>

            <div style="margin-bottom: 30px;">
                <h3 style="color: #4A154B; font-family: serif; margin-bottom: 15px;">Instructions</h3>
                <InputTextArea @bind-Value="FormModel.Instructions" placeholder="Step 1; Step 2; Step 3..."
                               style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #eee; height: 100px;" />
            </div>

            <div style="display: flex; gap: 20px; margin-bottom: 30px;">
                <div>
                    <label style="display: block; margin-bottom: 5px; font-size: 0.9rem;">Time (min)</label>
                    <InputNumber @bind-Value="FormModel.PreparationTime" style="width: 80px; padding: 10px; border-radius: 10px; border: 1px solid #eee;" />
                </div>
                <div>
                    <label style="display: block; margin-bottom: 5px; font-size: 0.9rem;">Calories</label>
                    <InputNumber @bind-Value="FormModel.Calories" style="width: 100px; padding: 10px; border-radius: 10px; border: 1px solid #eee;" />
                </div>
            </div>

            <div style="margin-bottom: 30px;">
                <h3 style="color: #4A154B; font-family: serif; margin-bottom: 15px;">Why it helps</h3>
                <InputTextArea @bind-Value="FormModel.WhyItHelps"
                               placeholder="Describe how this meal supports hormonal balance..."
                               style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #eee; height: 80px;" />
            </div>

            <div style="margin-bottom: 30px;">
                <h3 style="color: #4A154B; font-family: serif; margin-bottom: 15px;">Hormone Heroes</h3>
                <p style="font-size: 0.8rem; color: #999; margin-bottom: 5px;">Key ingredients (separate with ;)</p>
                <InputText @bind-Value="FormModel.Category"
                           placeholder="Salmon; Avocado; Ginger"
                           style="width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #eee;" />
            </div>

            <button type="submit" style="background: #FF2D55; color: white; border: none; padding: 15px 40px; border-radius: 30px; font-weight: bold; width: 100%; cursor: pointer; font-size: 1.1rem;">
                Save Recipe 🩷
            </button>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    public Recipe FormModel { get; set; } = new Recipe();

    private string? errorMessage;
    private long maxFileSize = 1024 * 1024 * 5;

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var file = e.File;
        
        var extension = Path.GetExtension(file.Name).ToLower();
        if (extension != ".jpg" && extension != ".png" && extension != ".jpeg")
        {
            errorMessage = "Niewłaściwy format pliku! Wybierz zdjęcie JPG lub PNG.";
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
            return;
        }

        try {
            var fileName = Guid.NewGuid().ToString() + extension;
            var path = Path.Combine(Environment.WebRootPath, "images", fileName);
            
            if (!Directory.Exists(Path.GetDirectoryName(path))) Directory.CreateDirectory(Path.GetDirectoryName(path)!);

            await using FileStream fs = new(path, FileMode.Create);
            await file.OpenReadStream(maxFileSize).CopyToAsync(fs);
            
            FormModel.ImageUrl = $"images/{fileName}";
        } 
        catch (Exception ex) {
            Console.WriteLine($"Upload error: {ex.Message}");
            errorMessage = "Błąd podczas wgrywania pliku.";
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(FormModel.Title) || 
            string.IsNullOrWhiteSpace(FormModel.Ingredients) || 
            string.IsNullOrWhiteSpace(FormModel.Instructions))
        {
            errorMessage = "Pola Title, Ingredients oraz Instructions nie mogą być puste!";
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
            return;
        }

        if (FormModel.PreparationTime <= 0 || FormModel.Calories <= 0)
        {
            errorMessage = "Czas przygotowania oraz kalorie muszą być większe od zera!";
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
            return;
        }

        if (string.IsNullOrEmpty(FormModel.ImageUrl)) FormModel.ImageUrl = "images/default.jpg";

        try {
            using var ctx = DbFactory.CreateDbContext();
            ctx.Recipes.Add(FormModel);
            await ctx.SaveChangesAsync();
            Navigation.NavigateTo("/");
        }
        catch (Exception ex) {
            Console.WriteLine($"Database error: {ex.Message}");
            errorMessage = "Wystąpił błąd podczas zapisu do bazy danych.";
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }
}