@page "/recipe/{Id:int}"
@using HormoneHarmony.Models
@using HormoneHarmony.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HormoneHarmony.Data.AppDbContext> DbFactory
@inject NavigationManager Navigation

<div style="padding: 20px 40px 60px 40px; max-width: 1100px; margin: 0 auto;">
    <a href="/" style="color: #666; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-bottom: 30px; font-weight: 500;">
        <span>←</span> Back to recipes
    </a>

    @if (recipe == null)
    {
        <div style="text-align: center; color: #D17D98; padding: 50px;">
            <h2>Loading recipe... 🩷</h2>
        </div>
    }
    else
    {
        <div style="position: relative; width: 100%; height: 350px; border-radius: 30px; overflow: hidden; margin-bottom: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            <img src="@recipe.ImageUrl" style="width: 100%; height: 100%; object-fit: cover;" />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); padding: 40px;">
                <h1 style="color: white; font-family: serif; font-size: 3.5rem; margin: 0; font-weight: bold;">@recipe.Title</h1>
            </div>
        </div>

        <div style="background: white; border-radius: 20px; padding: 25px; display: flex; justify-content: center; gap: 50px; margin-bottom: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #fceef2;">
            <span style="display: flex; align-items: center; gap: 10px; color: #4A154B; font-weight: 500; font-size: 1.1rem;">
                <span style="color: #FF2D55; font-size: 1.3rem;">⏱</span> @recipe.PreparationTime min
            </span>
            <span style="display: flex; align-items: center; gap: 10px; color: #4A154B; font-weight: 500; font-size: 1.1rem;">
                <span style="color: #FF2D55; font-size: 1.3rem;">🔥</span> @recipe.Calories kcal
            </span>
            <span style="display: flex; align-items: center; gap: 10px; color: #4A154B; font-weight: 500; font-size: 1.1rem;">
                <span style="color: #FF2D55; font-size: 1.3rem;">ℹ️</span> @GetIngredientCount() Ingredients
            </span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1.8fr; gap: 40px;">

            <div style="display: flex; flex-direction: column; gap: 20px;">
                <div style="background: #FFF0F3; border-radius: 20px; padding: 30px;">
                    <h3 style="color: #4A154B; font-family: serif; font-size: 1.8rem; margin-top: 0; margin-bottom: 20px;">Ingredients</h3>
                    <ul style="list-style-type: none; padding: 0; margin: 0;">
                        @foreach (var item in GetList(recipe.Ingredients))
                        {
                            <li style="margin-bottom: 15px; color: #4A154B; display: flex; align-items: flex-start; gap: 12px; font-weight: 500; line-height: 1.4;">
                                <span style="color: #FF2D55; font-size: 0.8rem; padding-top: 4px;">●</span> @item
                            </li>
                        }
                    </ul>
                </div>

                <div style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #fceef2;">
                    <h3 style="color: #4A154B; font-family: serif; font-size: 1.3rem; margin-top: 0; margin-bottom: 20px;">Hormone Heroes</h3>
                    <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                        @foreach (var hero in GetList(recipe.Category))
                        {
                            <span style="background: #FFE4E8; color: #4A154B; padding: 8px 18px; border-radius: 20px; font-size: 0.9rem; font-weight: 600;">@hero</span>
                        }
                    </div>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 40px;">
                <div>
                    <h3 style="color: #4A154B; font-family: serif; font-size: 1.8rem; margin-top: 0; margin-bottom: 30px;">Instructions</h3>
                    @{
                        var steps = GetList(recipe.Instructions);
                    }
                    @for (int i = 0; i < steps.Count; i++)
                    {
                        <div style="display: flex; gap: 20px; margin-bottom: 30px; align-items: flex-start;">
                            <div style="background: #FFE4E8; color: #4A154B; width: 35px; height: 35px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-weight: bold; flex-shrink: 0;">
                                @(i + 1)
                            </div>
                            <p style="margin: 0; color: #4A154B; line-height: 1.7; padding-top: 5px; font-weight: 500;">@steps[i]</p>
                        </div>
                    }
                </div>

                <div style="background: #FFF0F3; border-radius: 20px; padding: 30px; border: 1px solid #FFE4E8;">
                    <h3 style="color: #4A154B; font-family: serif; font-size: 1.5rem; margin-top: 0; margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: #FF2D55;">❤️</span> Why it helps
                    </h3>
                    <p style="margin: 0; color: #A05E73; font-style: italic; line-height: 1.6; font-size: 1.05rem;">
                        "@recipe.WhyItHelps"
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Recipe? recipe;

    protected override async Task OnInitializedAsync()
    {
        using var ctx = DbFactory.CreateDbContext();
        recipe = await ctx.Recipes.FindAsync(Id);
    }

    private List<string> GetList(string? rawData)
    {
        if (string.IsNullOrWhiteSpace(rawData)) return new List<string>();
        return rawData.Split(';', StringSplitOptions.RemoveEmptyEntries)
                      .Select(s => s.Trim())
                      .ToList();
    }

    private int GetIngredientCount()
    {
        return GetList(recipe?.Ingredients).Count;
    }
}